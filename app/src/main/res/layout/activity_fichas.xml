<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GESTIÓN DE FICHAS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtCodigoFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Código de la ficha"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtNombreFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nombre de la ficha"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtCategoriaFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Categoría"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtTelaFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Tipo de tela"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtObservacionesFicha"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Observaciones"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnGuardarFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="GUARDAR FICHA"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnConsultarFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CONSULTAR FICHA"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnActualizarFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ACTUALIZAR FICHA"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnEliminarFicha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ELIMINAR FICHA"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

</ScrollView>